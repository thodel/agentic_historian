# The bot's full environment template — every tunable config.py reads. Copy to
# .env.gpustack at the REPO ROOT and fill in. NEVER commit the real key;
# .env.gpustack is gitignored. In production the bot reads its own secrets file
# instead (deploy/systemd/dh-bot.env.example → /etc/dh-bot.env, S2 #567).
# (Lived in the OpenClaw workspace/ until S3, #568, lifted that out of the repo.)
GPUSTACK_API_KEY=your_api_key_here
GPUSTACK_BASE_URL=https://gpustack.unibe.ch/v1

# Role-based model routing
GPUSTACK_MODEL_VISION=qwen3.8-27b                  # Agent A (HTR) + Agent B (description)
GPUSTACK_MODEL_TEXT=gpt-oss-120b                      # Agent C (NER) + corpus/meta + reconcile
GPUSTACK_MODEL_ORCHESTRATOR=minimax-m2.7             # future NL/SitL orchestrator (WP1)

# Retrieval (planned: hub linking + corpus semantic analysis)
GPUSTACK_MODEL_EMBEDDING=qwen3-embedding-0.6b
GPUSTACK_MODEL_RERANKER=jina-reranker-v2-base-multilingual

# gpt-oss-120b is a reasoning model — keep this budget generous
GPUSTACK_TEXT_MAX_TOKENS=4096

# HTR VLM anti-repetition decoding (#275). Applied only to transcription calls.
VLM_FREQUENCY_PENALTY=0.2
VLM_PRESENCE_PENALTY=0.0

# HLS-DHS linking (offline, from a local dump). Drop your dump at the path below
# (see knowledge_hub/hub.py for the JSON format), then set ENABLE_HLS_LOOKUP=true.
ENABLE_HLS_LOOKUP=false
HLS_DATA_PATH=knowledge_hub/data/hls.json

# SwitchDrive ingestion (WebDAV app password). Used by the /pull command.
SWITCHDRIVE_URL=https://drive.switch.ch/remote.php/webdav
SWITCHDRIVE_USER=
SWITCHDRIVE_PASS=
SWITCHDRIVE_REMOTE_DIR=agentic_historian_hotfolder

# ── Nextcloud public share (batch ATR ingestion, docs/BATCH_ATR.md) ──────────
# Paste the share URL as the browser shows it — including the
# .../authenticate/showshare a password-protected share redirects to. The share
# TOKEN is the WebDAV username; NEXTCLOUD_SHARE_PASS is the share password
# (leave empty for a share that has none).
NEXTCLOUD_SHARE_URL=
NEXTCLOUD_SHARE_PASS=
NEXTCLOUD_REMOTE_DIR=

# ── Batch ATR (multi-model comparison runs) ─────────────────────────────────
# NEXTCLOUD_STAGING_DIR: where a share is mirrored to (default data/nextcloud)
# VLM_TEST_ROOT:         root for comparison runs   (default data/vlm_test)
# ATR_BATCH_PAGE_CONCURRENCY: pages in flight per model. 1 on purpose — the
#   gateway already recognises a page's lines ~6 at a time, so a second page in
#   flight queues against the same GPU instead of finding an idle one.
# ATR_BATCH_RETRIES: retries per page for timeouts and 5xx. A 4xx is never
#   retried; a 404 abandons that model, because every page would fail the same.
NEXTCLOUD_STAGING_DIR=
VLM_TEST_ROOT=
ATR_BATCH_PAGE_CONCURRENCY=1
ATR_BATCH_RETRIES=2

# ── An external model API, through its OpenAI-compatible surface ─────────────
# Google serves Gemini at the base URL below. `openai` is already a dependency,
# so there is no vendor SDK. Empty key = no external reader.
# NEVER pass the key on a command line: argv is in `ps` and in the history.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_S=180

# ── The edition's correspondence register (docs/HF_DATASET.md) ──────────────
# data/letters of a michaelscho/lassberg checkout — the only record of whose
# hand a page is in. Everything else infers it from a dateline.
#   git clone --depth 1 https://github.com/michaelscho/lassberg
LASSBERG_REGISTER=
