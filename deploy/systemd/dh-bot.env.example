# dh-bot.env — the Historian bot's OWN secrets, separate from the OpenClaw agent.
#
# S2 of the separation epic (#567). Install on tei as a root-owned, 0600 file the
# bot process reads INSTEAD of the shared .env.gpustack (which also holds the
# OpenClaw agent's mail / calendar / SSH credentials):
#
#   sudo install -m 600 -o root -g root dh-bot.env /etc/dh-bot.env
#   # then fill in the real values below, and point the unit at it:
#   #   deploy/systemd/agentic-historian.service.d/secrets.conf
#
# The bot picks this up via AH_ENV_FILE (config.py): with AH_ENV_FILE set, the bot
# reads ONLY this file for its file-sourced secrets and never falls back to
# .env.gpustack. Copy ONLY the keys below from the old .env.gpustack; do NOT copy
# any key the OpenClaw agent uses (IMAP/SMTP, CalDAV, SSH keys, etc.).
#
# Non-secret tunables (model names, thresholds, feature flags, channel IDs) all
# have defaults in config.py — set one here only to override it.

# ── Secrets the bot's commands actually need ─────────────────────────────────
DISCORD_BOT_TOKEN=            # the bot's OWN Discord application token (see S1 / #566) — NOT dh-bot's
GPUSTACK_API_KEY=            # GPUStack (embeddings, text, vision, rerank, orchestrator models)
ATR_API_KEY=                 # ATR gateway on idhefix (start/read jobs)
GITHUB_TOKEN=                # write on the outputs repo; branch/PR on the code repo
SWITCHDRIVE_PASS=            # SwitchDrive hot-folder share password
NEXTCLOUD_SHARE_PASS=        # Nextcloud published-outputs share password
HF_TOKEN=                    # Hugging Face (dataset/model export)
GEMINI_API_KEY=              # only if the external-model read path is used; otherwise leave empty

# ── Deployment-specific, non-secret but usually set per host ─────────────────
GPUSTACK_BASE_URL=
ATR_GATEWAY_URL=
SWITCHDRIVE_URL=
SWITCHDRIVE_USER=
NEXTCLOUD_SHARE_URL=
GITHUB_OUTPUT_REPO=
GITHUB_CODE_REPO=
DISCORD_GUILD_ID=
REQUIRED_DISCORD_ROLE_ID=    # set it — the fail-closed gate (SEC-1) restricts commands to this role
REQUIRED_ADMIN_ROLE_ID=      # dedicated admin role for /update (SEC-5)
