# agentic_historian.env — the bot's OWN secrets, separate from the OpenClaw agent.
#
# Named after the bot (`agentic_historian`, decided 17.10.2026), not after
# `dh-bot` — that is the OpenClaw agent's Discord identity (SEPARATION.md S1),
# and naming the bot's secrets file after it is how the two got conflated.
# On tei the old path /etc/dh-bot.env still exists, holds three keys and is
# read by nobody (docs/DEPLOYMENT_TEI.md); the new one replaces it.
#
# S2 of the separation epic (#567). Install on tei as a root-owned, 0600 file the
# bot process reads INSTEAD of the shared .env.gpustack (which also holds the
# OpenClaw agent's mail / calendar / SSH credentials):
#
#   sudo install -m 600 -o root -g root agentic_historian.env /etc/agentic_historian.env
#   # then fill in the real values below, and point the unit at it:
#   #   deploy/systemd/agentic-historian.service.d/secrets.conf
#
# The bot picks this up via AH_ENV_FILE (config.py): with AH_ENV_FILE set, the bot
# reads ONLY this file for its file-sourced secrets and never falls back to
# .env.gpustack. Copy ONLY the keys below; do NOT copy any key the OpenClaw
# agent uses (IMAP/SMTP, CalDAV, SSH keys, etc.).
#
# THREE source files, not one. With AH_ENV_FILE set the bot reads this file and
# nothing else, so every dotenv file it read before has to be folded in. On tei
# (measured 22.10.2026) that is .env.gpustack (secrets, URLs, switches), .env at
# the checkout root (HF_TOKEN, DISCORD_GUILD_ID, both REQUIRED_*_ROLE_ID) and
# agentic_historian/.env (ATR_MOUNT_DIR). Before installing, measure what the
# new file would change instead of trusting the copy:
#
#   sudo agentic_historian/.venv/bin/python deploy/systemd/env_diff.py /etc/agentic_historian.env
#
# It prints the names of the settings that differ — never a value — and an
# empty list is the condition for the switch.
#
# Non-secret tunables (model names, thresholds, feature flags, channel IDs) all
# have defaults in config.py — set one here only to override it. The GPUSTACK_MODEL_*
# and GEMINI_* lines in tei's .env.gpustack equal those defaults today, and
# GEMINI_MODEL, GEMINI_THINKING, GEMINI_CONCURRENCY are read by nothing (22.10.2026).
# TRANSKRIBUS_USER/PASS/COLLECTION serve the CLI, which runs as dh from the
# checkout's dotenv files, not the bot — they do not belong here.

# ── Secrets the bot's commands actually need ─────────────────────────────────
DISCORD_BOT_TOKEN=            # the bot's OWN Discord application token (see S1 / #566) — NOT dh-bot's
GPUSTACK_API_KEY=            # GPUStack (embeddings, text, vision, rerank, orchestrator models)
ATR_API_KEY=                 # ATR gateway on idhefix (start/read jobs)
GITHUB_TOKEN=                # write on the outputs repo; branch/PR on the code repo
SWITCHDRIVE_PASS=            # SwitchDrive hot-folder share password
NEXTCLOUD_SHARE_PASS=        # Nextcloud published-outputs share password
HF_TOKEN=                    # Hugging Face (dataset/model export)
GEMINI_API_KEY=              # only if the external-model read path is used; otherwise leave empty

# ── Deployment-specific, non-secret but usually set per host ─────────────────
GPUSTACK_BASE_URL=
ATR_GATEWAY_URL=
SWITCHDRIVE_URL=
SWITCHDRIVE_USER=
NEXTCLOUD_SHARE_URL=
GITHUB_OUTPUT_REPO=
GITHUB_CODE_REPO=
DISCORD_GUILD_ID=
REQUIRED_DISCORD_ROLE_ID=    # set it — the fail-closed gate (SEC-1) restricts commands to this role
REQUIRED_ADMIN_ROLE_ID=      # admin-only commands (/campaign, /env_reload, …). Empty: those inherit
                             # REQUIRED_DISCORD_ROLE_ID, but /update stays refused for everyone —
                             # the deploy trigger needs this set in its own right (SEC-5, #576)

# ── Paths and names the host sets, with a default that is wrong for tei ──────
#
# These are the four settings that changed when the file held only the keys
# above (env_diff.py on tei, 22.10.2026). Each one silently falls back to a
# default that points somewhere else; none of them is a secret.
ATR_MOUNT_DIR=               # where the ATR gateway's job tree is mounted; default /mnt/gwdg
                             # (lived in agentic_historian/.env, not in .env.gpustack)
ATR_PAGE_CACHE_ARCHIVE=      # cold tier of the page cache on the research share; read-only
                             # for the bot — written by tei-vm-sanity's cron, not listed in
                             # hardening.conf on purpose (writable_paths.py says why)
LASSBERG_REGISTER=           # the Lassberg register the ATR jobs reference
ATR_DATASETS_DIR=            # ground-truth trees too large for the checkout (#710); on tei
                             # /mnt/wbkolleg_dh_1/tei/datasets — `upload_hf("datasets:<name>")`
NEXTCLOUD_REMOTE_DIR=        # target folder on the Nextcloud share; default empty
SWITCHDRIVE_REMOTE_DIR=      # hot-folder path on SwitchDrive; default agentic_historian_hotfolder

# ── Feature switches that are OFF by default ─────────────────────────────────
#
# The comment above says non-secret tunables "all have defaults in config.py —
# set one here only to override it", and for a threshold that is fine. For these
# it is not: the default is *off*, so leaving them out does not keep a default,
# it leaves a feature not running — and a feature that is not running looks
# exactly like one that is broken. They are listed here because this file is the
# operator's checklist, and a checklist that omits them cannot be worked through.
#
# `bot.log_security_posture` reports the gate-relevant ones at startup
# (SEC-19, #646); these are the rest.

ENABLE_GITHUB_PUBLISH=false  # the whole publishing path: catalogue pages, /find links,
                             # training reports (/train_publish refuses outright while false)
ENABLE_HOT_FOLDER_WATCH=true # default ON — the only one here that is. Set false on a host
                             # that must not ingest.

# Two switches that each need a channel as well, because a watcher posting where
# nobody chose is a watcher that gets muted.
ENABLE_ATR_WATCH=false       # training outcomes + unexplained GPU memory (#418).
ATR_WATCH_CHANNEL_ID=        # BOTH are required: the flag alone does nothing.
ATR_WATCH_MENTION=           # "<@123…>" for a person, "<@&123…>" for a role. Empty = no
                             # mention, so a failure waits until somebody looks.

CREDENTIAL_WATCH_CHANNEL_ID= # no flag for this one — the channel IS the switch. Empty = the
                             # watcher does not run, which is right for a host that does not
                             # ingest and wrong for the one that does.

ENABLE_VERBOSE_PROGRESS=false  # live progress board in one editing message (#289)
VERBOSE_PROGRESS_CHANNEL_ID=   # fallback channel for background runs (hot folder, SwitchDrive)
                               # that have no invoking command; unset → those stay log-only.

ENABLE_VOYANT_UPLOAD=false   # SEC-12 (#583): /agent_d would upload up to 50k chars of corpus
                             # text to Voyant and post a publicly shareable link. Leave false
                             # unless the corpus is cleared for publication.

# Pipeline behaviour — defaults are deliberate, change only with a reason.
ENABLE_MULTI_ENGINE_FUSION=false
ENABLE_ENSEMBLE_HTR=false
ENABLE_ROUTING_PRIOR=false
ENABLE_HLS_LOOKUP=false
ENABLE_MCP_LINKING=true
