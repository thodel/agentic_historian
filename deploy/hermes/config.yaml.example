# ~/.hermes/config.yaml for dh-bot on tei (H2 #798, H4 #800) — structure, no secrets.
# Keys follow Hermes' cli-config.yaml.example; `hermes config set` writes the same
# file, so either way works. Secrets live in ~/.hermes/.env (see env.example).

model:
  provider: custom                      # GPUStack is OpenAI-compatible
  base_url: https://gpustack.unibe.ch/v1
  default: qwen3.8-27b                  # OpenClaw's default too
  # api key: GPUSTACK_API_KEY in .env

providers:
  gpustack-oss:                         # the reasoning model, pinned per job only
    base_url: https://gpustack.unibe.ch/v1
    model: gpt-oss-120b
    key_env: GPUSTACK_API_KEY
    request_timeout_seconds: 600

agent:
  max_turns: 60
  reasoning_effort: medium
  restart_after_turn_timeout: 300       # a turn parked on a clarify card held a restart for 30 min (06.11.)

platforms:
  discord:
    enabled: true
    # token, allowed roles, home channel: DISCORD_* in .env

discord:
  require_mention: true
  thread_require_mention: true
  auto_thread: false
  # free_response_channels: []        # none: dh-bot answers when addressed

security:
  approval:
    transport: discord
approvals:
  mode: smart                           # auxiliary check; `manual` while testing
  cron_mode: deny                       # a cron run never gets a dangerous command through
  unattended_mode: deny
  # Checked before everything else, in every session, --yolo included: the
  # detours the first probes tried on their way to a batch (#801) — SSH, the
  # two GPU hosts, the gateway ports, the batch client. dh-bot reaches the
  # Historian over atr-mcp only.
  deny:
    - "ssh *"
    - "*ssh *"
    - "scp *"
    - "*130.92.59.240*"
    - "*130.92.59.242*"
    - "*:8200*"
    - "*:8201*"
    - "*atr_batch*"
# Rule keys the queue worker needs even under cron_mode: deny (the first run,
# 2026-11-05, was blocked on both): writing the state file and the PR body
# through a heredoc, and dropping its own branch after a failed attempt.
# Nothing else — `rm -r`, `systemctl`, `sh -c` stay denied in cron runs.
command_allowlist:
  - script execution via heredoc
  - git branch force delete

terminal:
  backend: local                        # runs as `hermes`; no view of /home/dh
  cwd: /home/hermes/dh-bot
  timeout: 1800

cron:
  catch_up_missed: true                 # per job overridden in cron.md (queue worker: off)
  max_parallel_jobs: 1

# The MCP federation (H4). Every source is Streamable HTTP at /mcp/<name>/mcp;
# /mcp/<name> alone is a landing page (302) — the OpenClaw trap.
mcp_servers:
  eos:
    url: https://tei.dh.unibe.ch/mcp/eos/mcp
  kf:
    url: https://tei.dh.unibe.ch/mcp/kf/mcp
  ssrq:
    url: https://tei.dh.unibe.ch/mcp/ssrq/mcp
  hbls:
    url: https://tei.dh.unibe.ch/mcp/hbls/mcp
  outremer:
    url: https://tei.dh.unibe.ch/mcp/outremer/mcp
  sikart:
    url: https://tei.dh.unibe.ch/mcp/sikart/mcp
  wd-pre1500:
    url: https://tei.dh.unibe.ch/mcp/wd-pre1500/mcp
  hls:
    url: https://tei.dh.unibe.ch/mcp/hls/mcp
    # HTTP Basic (mcp-hls on idhefix, HLS_AUTH_USER/HLS_AUTH_PASS in its .env);
    # HLS_BASIC is base64("user:pass") in ~/.hermes/.env. ${VAR} resolves from
    # .env, and an unset variable fails the entry closed instead of retrying 401s.
    headers:
      Authorization: "Basic ${HLS_BASIC}"
  # dmj: the Digital Medievalist editorial MCP (dmj_management on tei, 8016),
  # bearer DMJ_MCP_TOKEN from /home/dh/dmj_management/.env — only with a
  # reading filter, it can act on OJS (#800, #801):
  # dmj:
  #   url: https://tei.dh.unibe.ch/mcp/dmj/mcp
  #   headers:
  #     Authorization: "Bearer ${DMJ_MCP_TOKEN}"
  #   tools:
  #     include: [...]
  # swisslib: not wired on tei (no nginx location, no tunnel to 8005) — nothing to add
  atr:
    url: https://tei.dh.unibe.ch/mcp/atr/mcp
    # OAuth 2.1 (PKCE, dynamic client registration) against the server's own
    # password form, deploy/mcp-atr/README.md; once: `hermes mcp login atr`,
    # the token then lives in ~/.hermes/mcp-tokens/atr.json and refreshes itself.
    auth: oauth
    # Reading tools only — dh-bot never operates the Historian (#801). The key
    # is `tools.include` (a list; `include_tools` is silently ignored, which
    # would hand dh-bot start_batch).
    tools:
      include:
        - server_status
        - gateway_models
        - job_status
        - job_log
        - batch_report
        - run_files
        - read_pages
        - compare_readings
        - research_list
        - share_list
        - ubelix_queue
        - ubelix_job
        - ubelix_record
        - ubelix_report
        - ubelix_prepared
        - ubelix_checkout
