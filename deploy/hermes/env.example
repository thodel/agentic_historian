# ~/.hermes/.env for dh-bot on tei — names only. chmod 600. Values through an
# editor, never on a command line (argv is in `ps`). Hermes reads this file;
# the terminal tool strips the environment from child processes, so a skill
# that needs a variable declares it (required_environment_variables).

# --- model ------------------------------------------------------------------
HERMES_CUSTOM_GPUSTACK_UNIBE_CH_API_KEY=   # model.api_key — the default model; the name Hermes gives gpustack.unibe.ch
GPUSTACK_API_KEY=                 # providers.gpustack-oss.key_env — the same key; rotate both in H6 (#802)

# --- Discord ----------------------------------------------------------------
DISCORD_BOT_TOKEN=                # test application until H6, then dh-bot's (1519706253314756758)
DISCORD_ALLOWED_ROLES=            # the project role id: humans who may ask and task dh-bot — OpenClaw had no allowlist (groupPolicy: open)
DISCORD_ALLOWED_USERS=817396581317738546,1474109314003108113   # Tobias, cl-bot; other bots that may talk to dh-bot by id, comma-separated — bots never get the role
DISCORD_HOME_CHANNEL=             # cron output and reminders; a test channel until H6
DISCORD_ALLOW_BOTS=mentions       # as OpenClaw (allowBots: mentions): a bot is answered only when it names @dh-bot in the text
                                  # (discord.bots_require_inline_mention stays true) — never `all`: two bots answering each
                                  # other on every message loop until the rate limit. The Historian bot reads no messages and
                                  # cannot talk here at all; dh-bot reaches it over atr-mcp (#800).

# --- the queue worker and repo status (H3) ----------------------------------
# No GH_TOKEN here: Hermes treats *_TOKEN as provider credentials and refuses to
# pass them to the terminal ("refusing to register Hermes provider credential").
# `gh` keeps its own login (`gh auth login --with-token`, README step 6), which
# replaces ~/.openclaw/tmp/.gh_token; H6 revokes that one.

# --- MCP sources that want a credential (H4, #800) ---------------------------
HLS_BASIC=                        # base64 of HLS_AUTH_USER:HLS_AUTH_PASS from mcp-hls on idhefix; never the pair itself
# DMJ_MCP_TOKEN=                  # when dmj is enabled, from /home/dh/dmj_management/.env — with a reading filter only
# atr needs nothing here: OAuth tokens live in ~/.hermes/mcp-tokens/atr*.json (hermes mcp login atr)

# --- not here ---------------------------------------------------------------
# No mail/calendar/SSH credentials until a skill needs them (#801); no key of the
# Historian bot ever (/etc/agentic_historian.env is unreadable for `hermes`).
