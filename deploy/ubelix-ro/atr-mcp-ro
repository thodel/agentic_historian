#!/usr/bin/env python3
"""atr-mcp-ro — the only thing the ATR MCP key may run on UBELIX (#674).

Installed as the forced command of one key in ``~/.ssh/authorized_keys``::

    restrict,command="$HOME/bin/atr-mcp-ro" ssh-ed25519 AAAA… atr-mcp@tei

sshd then runs this script whatever the client asked for, and puts the request
in ``SSH_ORIGINAL_COMMAND``. Eight requests are understood, all read-only:

* ``queue`` — this user's jobs in ``squeue``, with Slurm's start estimate.
* ``job <slurm id>`` — ``sacct -D`` for one job, preemptions and requeues included.
* ``record <job id> [lines]`` — the trainer's record (``job.json``: status,
  timestamps, error, metrics) and the tail of the log of its current stage.
* ``report <job id> [label]`` — the evaluation reports in the job's ``data/``:
  without a label, which there are; with one, that report (without its ten
  example transcriptions) and its held-out check, if it has one (#301).
* ``prepared <slurm id>`` — what a ``prepare.sbatch`` run left for stage 2
  (#740): the trainer job id it wrote to ``runs/prep-<slurm id>.jobid``, the
  Slurm state, the record's status, and the ``train.sbatch`` line its log ends
  with — the id and the command a person otherwise read off two files.
* ``checkout`` — the trainer checkout ``submit.sh`` runs (``~/training-atr-models``):
  HEAD, uncommitted files, and how far it is from ``origin/main`` by
  ``git ls-remote``, which fetches nothing. The question the preflight refused on
  twice on 26.10.
* ``purge-candidates <share|scratch> <statuses> [YYYY-MM-DD]`` — what a clean-up
  of ``jobs/*/data`` would take and what it must not (agentic_historian#824):
  runs the checkout's ``ubelix/plan_purge.py --json`` (training-atr-models#387)
  with a fixed argv and **without** ``--write``. The protection rules live in
  that script; this one does not restate them.
* ``plan <purge-YYYYMMDDTHHMMSSZ>`` — a plan a person wrote with
  ``plan_purge.py --write``: its content and sha256, ``plan_purge.py --verify``
  on it, and the log of each ``apply_purge.sh`` run that executed it.

Nothing here deletes, submits or writes: a plan is written and applied by a
person on the login node, one line each.

Everything else exits 2 without running anything. There is no shell on this path:
the request is split on whitespace, every word is matched against a pattern, and
what runs is a fixed argv handed to ``execve``. Python 3.7+ and the standard
library only, because this runs on a login node with whatever ``python3`` it has.
"""

from __future__ import annotations

import getpass
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

SLURM_ID_RE = re.compile(r"^[0-9]{1,12}$")
RECORD_RE = re.compile(r"^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9._-]{0,120}$")
STAGE_RE = re.compile(r"^[a-z_]{1,32}$")
LINES_RE = re.compile(r"^[0-9]{1,3}$")
#: A report label as ``rescore_on_shared_draw.py`` writes it: a set name or a job
#: id (``eval_report.<label>.json``), or ``_`` for the run's own
#: ``eval_report.json``. No slash, so it names a file in ``data/`` and nothing else.
LABEL_RE = re.compile(r"^(_|[A-Za-z0-9][A-Za-z0-9._-]{0,120})$")
#: ``purge-candidates``: a jobs root by name, never a path; the statuses
#: ``plan_purge.py`` takes (a running job is never one); a date.
PURGE_ROOT_RE = re.compile(r"^(share|scratch)$")
STATUSES_RE = re.compile(r"^(failed|cancelled|completed)(,(failed|cancelled|completed)){0,2}$")
DATE_RE = re.compile(r"^20[0-9]{2}-[01][0-9]-[0-3][0-9]$")
#: A plan as ``plan_purge.py --write`` names it, without ``.json``. No slash and
#: no dot, so it names a file in the plans directory and nothing else.
PLAN_RE = re.compile(r"^purge-[0-9]{8}T[0-9]{6}Z$")

MAX_LINES = 200
DEFAULT_LINES = 40
#: How much of a log's end is read to find its last lines. A training log can
#: be gigabytes; its tail is all anybody asks for.
TAIL_BYTES = 256 * 1024
#: The record fields worth handing out. job.json carries the full request too,
#: and nobody polling a queue needs that. ``metrics`` is the evaluation result
#: (``cer``, ``wer``, ``samples``, …; a flat dict of numbers): the job store
#: refuses ``completed`` without a ``cer``, so a finished record without it here
#: was a record read through a filter, not one without a number (24.10.2026).
#: ``registration``, ``promoted`` and ``promotion_reason`` are what a finished
#: Slurm job leaves for the hand registration on asteraix: the weights directory
#: and the YAML to write (training-atr-models#17). On 31.10.2026 a person had to
#: open job.json on UBELIX for them, because this filter dropped them.
RECORD_FIELDS = ("id", "status", "stage", "host", "created_at", "updated_at",
                 "finished_at", "error", "metrics",
                 "registration", "promoted", "promotion_reason")

REFUSED = 2


def user() -> str:
    return os.environ.get("USER") or getpass.getuser()


def jobs_root() -> Path:
    """Where the trainer keeps its records on UBELIX (training-atr-models'
    ``ubelix/`` scripts). ``ATR_MCP_RO_JOBS`` exists for the tests: sshd does
    not pass a client's environment into a forced command unless ``AcceptEnv``
    names it, and nothing names this one."""
    override = os.environ.get("ATR_MCP_RO_JOBS")
    if override:
        return Path(override)
    return Path("/scratch/network/users") / user() / "runs" / "jobs"


def runs_root() -> Path:
    """``$S/runs`` of the ubelix scripts, beside the jobs root."""
    override = os.environ.get("ATR_MCP_RO_RUNS")
    return Path(override) if override else jobs_root().parent


def logs_root() -> Path:
    """``#SBATCH --output=/storage/homefs/%u/ubelix/logs/%x-%j.out``."""
    override = os.environ.get("ATR_MCP_RO_LOGS")
    return Path(override) if override else Path.home() / "ubelix" / "logs"


def repo_root() -> Path:
    """The checkout ``submit.sh`` runs (``ATR_TRAIN_REPO``'s default)."""
    override = os.environ.get("ATR_MCP_RO_REPO")
    return Path(override) if override else Path.home() / "training-atr-models"


def share_jobs_root() -> Path:
    """The trainer's jobs on the research storage (``training_folder/jobs``)."""
    override = os.environ.get("ATR_MCP_RO_SHARE_JOBS")
    return Path(override) if override else Path(
        "/storage/research/wbkolleg_dh_1/Textrecognition_Training/training_folder/jobs")


def plans_root() -> Path:
    """Where ``plan_purge.py --write`` puts its plans."""
    override = os.environ.get("ATR_MCP_RO_PLANS")
    return Path(override) if override else Path.home() / "ubelix" / "plans"


def planner() -> Path:
    return repo_root() / "ubelix" / "plan_purge.py"


def capture(argv: list) -> tuple:
    """``(exit code, stdout)`` of a fixed argv, for answers that are parsed."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=20)
        return done.returncode, done.stdout
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""


def capture_all(argv: list, timeout: int = 20) -> tuple:
    """``(exit code, stdout, stderr)`` of a fixed argv."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return done.returncode, done.stdout, done.stderr
    except FileNotFoundError:
        return 127, "", argv[0] + ": not found"
    except subprocess.TimeoutExpired:
        return 124, "", argv[0] + ": timed out after %d s" % timeout


def refuse(why: str) -> int:
    print("refused: " + why, file=sys.stderr)
    return REFUSED


def run(argv: list) -> int:
    # The child writes straight to the fd; through ssh that is a pipe, where our
    # own print()s sit in a buffer and would come out after it.
    sys.stdout.flush()
    try:
        return subprocess.run(argv, timeout=20).returncode
    except FileNotFoundError:
        print(argv[0] + ": not found", file=sys.stderr)
        return 127
    except subprocess.TimeoutExpired:
        print(argv[0] + ": timed out after 20 s", file=sys.stderr)
        return 124


def queue() -> int:
    me = user()
    code = run(["squeue", "-u", me,
                "-o", "%.10i %.12P %.40j %.9T %.11M %.20S %R"])
    print("== start estimates")
    return code or run(["squeue", "-u", me, "--start", "-h",
                        "-o", "%.10i %.20S %R"])


def job(slurm_id: str) -> int:
    return run(["sacct", "-j", slurm_id, "-u", user(), "-D", "-X",
                "--format=JobID,JobName%40,State,Submit,Start,End,Elapsed,"
                "NodeList%12,ExitCode"])


def tail(path: Path, lines: int) -> list:
    with path.open("rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        fh.seek(max(0, size - TAIL_BYTES))
        data = fh.read()
    return data.decode("utf-8", "replace").splitlines()[-lines:]


def record(record_id: str, lines: int) -> int:
    root = jobs_root()
    path = root / record_id / "job.json"
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        print(json.dumps({"id": record_id, "error": "no such record"}))
        return 1
    except (OSError, ValueError) as exc:
        print(json.dumps({"id": record_id, "error": "unreadable: %s" % exc}))
        return 1
    out = {k: raw[k] for k in RECORD_FIELDS if k in raw}
    out.setdefault("id", record_id)

    logs = root / record_id / "logs"
    stage = raw.get("stage")
    candidates = []
    if isinstance(stage, str) and STAGE_RE.match(stage):
        candidates.append(logs / (stage + ".log"))
    # In-process stages (prepare, compile) write only runner.log; the trainer's
    # own _failure_log falls back the same way.
    candidates.append(logs / "runner.log")
    for log in candidates:
        try:
            if log.is_file() and log.stat().st_size:
                out["log"] = {"path": str(log), "tail": tail(log, lines)}
                break
        except OSError:
            continue
    else:
        out["log"] = None
    print(json.dumps(out, ensure_ascii=False))
    return 0


def report_path(data: Path, label: str) -> Path:
    return data / ("eval_report.json" if label == "_" else "eval_report.%s.json" % label)


def report(record_id: str, label) -> int:
    """List a job's evaluation reports, or hand one out.

    The rescore of a finished run writes ``data/eval_report.<label>.json`` and,
    with ``--heldout``, ``eval_report.<label>.heldout.json`` beside it; neither
    reaches the record, which is why ``record`` cannot show them. ``examples`` —
    ten full reference/prediction pairs — is left out: it is for eyeballing on the
    box, and for a page set it is most of the file.
    """
    data = jobs_root() / record_id / "data"
    if not data.is_dir():
        print(json.dumps({"id": record_id, "error": "no data directory"}))
        return 1
    if label is None:
        labels = []
        for path in sorted(data.glob("eval_report*.json")):
            name = path.name
            if name.endswith(".heldout.json"):
                continue
            labels.append("_" if name == "eval_report.json"
                          else name[len("eval_report."):-len(".json")])
        # The run's own first, then the rescores by name.
        labels.sort(key=lambda name: (name != "_", name))
        print(json.dumps({"id": record_id, "reports": labels}))
        return 0
    path = report_path(data, label)
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        print(json.dumps({"id": record_id, "label": label, "error": "no such report"}))
        return 1
    except (OSError, ValueError) as exc:
        print(json.dumps({"id": record_id, "label": label, "error": "unreadable: %s" % exc}))
        return 1
    if isinstance(raw, dict):
        raw.pop("examples", None)
    heldout = None
    sidecar = data / ("eval_report.%s.heldout.json" % label)
    if label != "_" and sidecar.is_file():
        try:
            heldout = json.loads(sidecar.read_text())
        except (OSError, ValueError) as exc:
            heldout = {"error": "unreadable: %s" % exc}
    print(json.dumps({"id": record_id, "label": label, "report": raw, "heldout": heldout},
                     ensure_ascii=False))
    return 0


TRAIN_LINE = "ubelix/submit.sh ubelix/train.sbatch"


def prepared(slurm_id: str) -> int:
    """What one prepare run left for stage 2 (#740). Read-only, JSON."""
    out = {"slurm_id": slurm_id, "trainer_id": None, "slurm": None,
           "record": None, "next": None, "artefact": None}
    idfile = runs_root() / ("prep-%s.jobid" % slurm_id)
    try:
        trainer_id = idfile.read_text().strip()
    except OSError:
        trainer_id = ""
    if trainer_id and RECORD_RE.match(trainer_id):
        out["trainer_id"] = trainer_id
    elif trainer_id:
        out["error"] = "the id file holds something that is not a trainer id"
    code, text = capture(["sacct", "-j", slurm_id, "-u", user(), "-X", "-n", "-P",
                          "--format=JobName,State,Start,End,ExitCode"])
    first = text.strip().splitlines()[0] if text.strip() else ""
    parts = first.split("|")
    if len(parts) == 5:
        out["slurm"] = dict(zip(("name", "state", "start", "end", "exit"), parts))
    elif first:
        out["slurm"] = {"raw": first[:200]}
    if out["trainer_id"]:
        try:
            raw = json.loads((jobs_root() / out["trainer_id"] / "job.json").read_text())
            out["record"] = {k: raw.get(k) for k in ("status", "stage", "updated_at", "error")}
        except (OSError, ValueError):
            out["record"] = None
    log = logs_root() / ("prep-%s.out" % slurm_id)
    try:
        lines = tail(log, 400) if log.is_file() else []
    except OSError:
        lines = []
    for line in reversed(lines):
        if out["next"] is None and TRAIN_LINE in line and "JOB_ID=" in line:
            out["next"] = line.strip()
        if out["artefact"] is None and "artefact" in line:
            out["artefact"] = line.strip()[-300:]
    print(json.dumps(out, ensure_ascii=False))
    return 0


def checkout() -> int:
    """The trainer checkout against origin/main, without fetching (#740)."""
    repo = str(repo_root())
    out = {"repo": repo}
    code, head = capture(["git", "-C", repo, "rev-parse", "HEAD"])
    if code != 0:
        print(json.dumps({"repo": repo, "error": "not a git checkout"}))
        return 1
    head = head.strip()
    out["head"] = head
    _, subject = capture(["git", "-C", repo, "log", "-1", "--format=%cs %s"])
    out["subject"] = subject.strip()[:200]
    _, status = capture(["git", "-C", repo, "status", "--porcelain", "--untracked-files=no"])
    out["uncommitted"] = len([l for l in status.splitlines() if l.strip()])
    code, remote = capture(["git", "-C", repo, "ls-remote", "origin", "refs/heads/main"])
    sha = remote.split()[0] if code == 0 and remote.strip() else None
    out["origin_main"] = sha
    if sha is None:
        out["behind"] = None
        out["note"] = "origin did not answer"
    elif sha == head:
        out["behind"] = 0
    else:
        known, _ = capture(["git", "-C", repo, "cat-file", "-e", sha + "^{commit}"])
        if known == 0:
            _, count = capture(["git", "-C", repo, "rev-list", "--count", "HEAD.." + sha])
            out["behind"] = int(count.strip() or 0)
        else:
            out["behind"] = None
            out["note"] = "origin/main is ahead by commits this checkout has not fetched"
    out["up_to_date"] = out["behind"] == 0 and out["uncommitted"] == 0
    print(json.dumps(out, ensure_ascii=False))
    return 0


def purge_candidates(root: str, statuses: str, before) -> int:
    """What ``plan_purge.py`` would put in a plan, without writing one (#824).

    The script decides what is protected and why; this hands its answer on,
    compacted. ``--write`` is not in the argv and cannot get there: no word of
    the request becomes an argument except the three matched above.
    """
    script = planner()
    if not script.is_file():
        print(json.dumps({"error": "no ubelix/plan_purge.py in %s — the checkout predates "
                                   "training-atr-models#387" % repo_root()}))
        return 1
    jobs = share_jobs_root() if root == "share" else jobs_root()
    argv = [sys.executable, str(script), "--json", "--jobs-root", str(jobs),
            "--status", statuses]
    if before:
        argv += ["--ended-before", before]
    code, out, err = capture_all(argv, timeout=25)
    if code != 0:
        print(json.dumps({"root": root, "exit": code, "error": err.strip()[-2000:]},
                         ensure_ascii=False))
        return 1
    try:
        plan = json.loads(out)
    except ValueError:
        print(json.dumps({"root": root, "error": "plan_purge.py did not answer in JSON",
                          "output": out[-2000:]}, ensure_ascii=False))
        return 1
    print(json.dumps({"root": root, "candidates": plan}, ensure_ascii=False,
                     separators=(",", ":")))
    return 0


#: How much of a plan file is read. A plan for every job there is stays well
#: under this; a file that does not is not one ``plan_purge.py`` wrote.
MAX_PLAN_BYTES = 2 * 1024 * 1024
#: How far into a purge log its plan path is looked for (``apply_purge.sh``
#: prints it on its first lines).
LOG_HEAD_BYTES = 4096
RUN_LINES = 120


def plan(name: str) -> int:
    """A written plan, its checksum, and the runs that applied it (#824)."""
    path = plans_root() / (name + ".json")
    if not path.is_file():
        print(json.dumps({"name": name, "error": "no such plan"}))
        return 1
    try:
        if path.stat().st_size > MAX_PLAN_BYTES:
            print(json.dumps({"name": name, "error": "larger than a plan"}))
            return 1
        raw = path.read_bytes()
        content = json.loads(raw.decode("utf-8"))
    except (OSError, ValueError) as exc:
        print(json.dumps({"name": name, "error": "unreadable: %s" % exc}))
        return 1
    out = {"name": name, "path": str(path), "sha256": hashlib.sha256(raw).hexdigest(),
           "plan": content, "verify": None, "runs": []}
    script = planner()
    if script.is_file():
        code, text, err = capture_all([sys.executable, str(script), "--verify", str(path)])
        out["verify"] = {"ok": code == 0, "output": (text.strip() or err.strip())[-1000:]}
    names = {str(path), str(path.resolve())}
    logs = []
    try:
        candidates = sorted(logs_root().glob("purge-*.out"), key=lambda p: p.stat().st_mtime)
    except OSError:
        candidates = []
    for log in candidates:
        try:
            with log.open("rb") as fh:
                head = fh.read(LOG_HEAD_BYTES).decode("utf-8", "replace")
        except OSError:
            continue
        if any("Plan " + n in head for n in names):
            logs.append(log)
    for log in logs[-3:]:
        try:
            out["runs"].append({"log": str(log), "tail": tail(log, RUN_LINES)})
        except OSError:
            continue
    print(json.dumps(out, ensure_ascii=False, separators=(",", ":")))
    return 0


VERBS = ("`queue`, `job ID`, `record ID [lines]`, `report ID [label]`, `prepared ID`, "
         "`checkout`, `purge-candidates share|scratch STATUSES [DATE]`, `plan NAME`")


def main() -> int:
    words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    if not words:
        return refuse("no request; this key runs " + VERBS)
    verb, args = words[0], words[1:]
    if verb == "queue" and not args:
        return queue()
    if verb == "job" and len(args) == 1 and SLURM_ID_RE.match(args[0]):
        return job(args[0])
    if verb == "record" and len(args) in (1, 2) and RECORD_RE.match(args[0]):
        if len(args) == 2 and not LINES_RE.match(args[1]):
            return refuse("lines must be a number")
        lines = min(MAX_LINES, max(1, int(args[1]))) if len(args) == 2 else DEFAULT_LINES
        return record(args[0], lines)
    if verb == "report" and len(args) in (1, 2) and RECORD_RE.match(args[0]):
        if len(args) == 2 and not LABEL_RE.match(args[1]):
            return refuse("not a report label")
        return report(args[0], args[1] if len(args) == 2 else None)
    if verb == "prepared" and len(args) == 1 and SLURM_ID_RE.match(args[0]):
        return prepared(args[0])
    if verb == "checkout" and not args:
        return checkout()
    if (verb == "purge-candidates" and len(args) in (2, 3) and PURGE_ROOT_RE.match(args[0])
            and STATUSES_RE.match(args[1])):
        if len(args) == 3 and not DATE_RE.match(args[2]):
            return refuse("the date is YYYY-MM-DD")
        return purge_candidates(args[0], args[1], args[2] if len(args) == 3 else None)
    if verb == "plan" and len(args) == 1 and PLAN_RE.match(args[0]):
        return plan(args[0])
    return refuse("not one of " + VERBS)


if __name__ == "__main__":
    sys.exit(main())
