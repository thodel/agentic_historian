   "norm": "",
   "ref": "org002673",
   "span_id": "",
   "text": "aͤptissin und gemeiner convent ze Gnadental"
  },
  {
   "class": "date",
   "entry_id": "U-17_0508",
   "norm": "1417-02-24",
   "ref": "",
   "span_id": "",
   "text": "in dˀ der"
  },
  {
   "class": "date",
   "entry_id": "U-17_0508",
   "norm": "1417-02-24",
   "ref": "",
   "span_id": "",
   "text": "vasten, dez jares nach Cristi geburt viertzechenhundert und in dem sybentzechen dn̄ den jare"
  },
  {
   "class": "measure",
   "entry_id": "U-17_0508",
   "norm": "",
   "ref": "",
   "span_id": "",
   "text": "zwen mùt kˀ ker nē nen geltz"
  },
  {
