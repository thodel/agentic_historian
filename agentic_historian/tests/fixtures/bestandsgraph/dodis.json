 "documents": [
  {
   "classification": null,
   "doc_date": "2005",
   "doc_type": "Bibliographischer Hinweis",
   "id": "15422",
   "is_scan": 0,
   "lang_code": "fr",
   "summary": null,
   "title": "Ruth Fivaz-Silbermann, Recueil de documents des archives du Comité international de la Croix-Rouge sur le sort des Juifs de France internés et déportés 1939-1945. Table des documents et index , Préface de Serge Klarsfeld, The Beate Klarsfeld Foundation. publié avec l'appui du CICR, Paris-Genève, 2005.",
   "year": 2005
  },
  {
   "classification": null,
   "doc_date": "2006",
   "doc_type": "Bibliographischer Hinweis",
   "id": "16422",
   "is_scan": 0,
   "lang_code": "ml",
   "summary": "Sommaire Avant-propos, Dimitri Tcherkachine, Ambassadeur de la Fédération russe en Suisse et Jean-Jacques de Dardel, Ambassadeur, Chef de la Division politique I, Département fédéral des affaires étrangères. En quête de Russie, Eric Hoesli, journaliste. Introduction, Laurent Golay, Directeur du Musée historique de Lausanne, Commissaire de l'exposition et Alexandra Karouova, Commissaire scientifique de l'exposition. Ils servirent leur patrie par l'épée et la plume, Nikolaï A. Kopanev, Bibliothèque nationale de Russie, Saint-Pétersbourg. Le génie helvétique au bord de la Neva..., Olga Kirikova, Université de Lausanne. Les savants suisses et la création de l'académie des sciences à Saint-Pétersbourg, Tatiana Moiseeva, Musée Pierre le Grand d'anthropologie et d'ethnographie (Kunskamera). Le Tessinois Giovanni (Jean, Ivan) Bianchi (1811-1893), pionnier de la photographie en Russie, A. Mario Redaelli et Pia Todorovitch Redaelli. Jérémie Pauzié, joaillier genevois à la cour des tsars (1716-1779), Mélanie Draveny, Université de Genève. «Un petit coin de Russie» Les Russes en Suisse, au XIXe et début du XXe siècle, Peter Collmer, Université de Zurich. Quand Strawinsky rencontre Ramuz, Alain Rochat, Centre de recherches sur les lettres romandes. «Ma femme et moi, nous aimons beaucoup Montreux...», Galina B. Glushanok, Fondation Nabokov, Saint-Pétersbourg.",
   "title": "Peter Collmer, Mélanie Draveny, Galina Glushanok, Eric Hoesli, Olga Kirikova, Nicolaï Kopanev, Tatiana Moisseeva, Mario Redaelli, Alain Rochat, et Pia Todorovic, Suisse-Russie : des siècles d'amour et d'oubli, 1680-2006 , Benteli Verlag et Musée historique de Lausanne, Wabern/Lausanne, deux versions (français et russe), février 2006, 96 pages dont 48 illustrations en couleur. (catalogue de l'exposition)",
   "year": 2006
  },
  {
   "classification": null,
   "doc_date": "12.6.1967",
   "doc_type": "Bundesratsprotokoll",
   "id": "32169",
   "is_scan": 1,
   "lang_code": "de",
   "summary": "Die schweizerischen Banken haben sich bereit erklärt Mexiko, als wichtigstem Handelspartner der Schweiz in Lateinamerika, einen Sonderkredit von 50 Mio. zu gewähren. Davon werden 30 Mio. für die Parallelfinanzierung eines Elektrifizierungsprogrammes mit der Weltbank verwendet. Darin: Volkswirtschaftsdepartement. Antrag vom 5.6.1967 (Beilage). Darin: Politisches Departement. Mitbericht vom 7.6.1967 (Einverstanden). Darin: Finanz- und Zolldepartement. Mitbericht vom 9.6.1967 (Einverstanden).",
   "title": "1024. Mexico, Gewährung eines Rahmenkredits von Fr. 50 Mio mit Bundesgarantie",
   "year": 1967
  },
  {
   "classification": null,
   "doc_date": "9.12.1969",
   "doc_type": "Aktennotiz / Notiz",
   "id": "32851",
   "is_scan": 0,
   "lang_code": "fr",
   "summary": "Après le Conseil des Etats, le Conseil national approuve à l'unanimité le crédit en faveur de l'augmentation de la contribution allouée à la coopération technique. Le nouveau programme de coopération technique est présenté.",
   "title": null,
   "year": 1969
  },
  {
   "classification": null,
   "doc_date": "29.1.1968",
   "doc_type": "Schreiben",
   "id": "33425",
   "is_scan": 0,
   "lang_code": "de",
   "summary": "Das Politische Departement nimmt Stellung zur Frage, in welchen Fällen ihm die Fabrikations-, die Ausfuhr- und die Durchfuhrbewilligungsgesuche für Kriegsmaterial zu unterbreiten sind.",
   "title": "Ausfuhr von Kriegsmaterial",
   "year": 1968
  }
 ],
