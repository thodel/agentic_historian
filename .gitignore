# Environment
.env.gpustack
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# OpenClaw
openclaw-workspace-state.json

# ── Agent scratch / working state — NEVER commit ─────────────────────────────
# A bot once dumped ~28,000 of these into a PR (#259): OpenClaw working dirs, its
# memory notes, scraped feeds, RDF sample exports, ad-hoc patch/debug scripts.
# These are agent scratch, not sources. `.openclaw/` (no leading slash) matches
# at any depth; the anchored dirs only ignore the repo-root scratch versions.
.openclaw/
/memory/
/sample/
/mcp/
/feeds/
*_master.py
add-z

# ── Corpora and pipeline inputs — keep the directory, never its contents ─────
# Evaluation sets and ingest material: third-party images and ground truth from
# Zenodo and HTR-United, fetched per run, tens of megabytes, and licence-bound in
# ways this repository does not carry. Only the .gitkeep is tracked, so `git add
# -A` would otherwise sweep the lot in — which is how #259 happened.
/agentic_historian/data/*
!/agentic_historian/data/.gitkeep

# Virtual envs
.venv/
agentic_historian/.venv/
